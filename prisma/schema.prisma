datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id             String         @id @default(cuid())
  email          String         @unique
  name           String?
  avatar         String?        @default("😊")
  moodEntries    MoodEntry[]
  journalEntries JournalEntry[]
  chatMessages   ChatMessage[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model MoodEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mood      String   // e.g. "Anxious", "Calm", "Low", "Joyful", "Overwhelmed", "Grateful", "Exhausted"
  intensity Int      // 1-10 scale
  note      String?
  tags      String?  // comma-separated tags e.g. "work, sleep, family"
  createdAt DateTime @default(now())
}

model JournalEntry {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String?
  content      String
  sentiment    String?  // "positive" | "neutral" | "negative" | "mixed"
  emotionTags  String?  // JSON or comma-separated detected emotions
  aiReflection String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   // "user" | "assistant" | "system"
  content   String
  riskFlag  Boolean  @default(false)
  sentiment String?  // emotion detected in user turn
  createdAt DateTime @default(now())
}
